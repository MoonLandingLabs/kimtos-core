{
  "name": "@kimtos/www-docs",
  "private": true,
  "type": "module",
  "description": "The documentation site (VitePress over the repo's Markdown) — fully static",
  "scripts": {
    "build-content": "node scripts/build-content.mjs",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "predev": "node scripts/build-content.mjs",
    "dev": "vitepress dev",
    "prebuild": "node scripts/build-content.mjs && node scripts/check-mermaid.mjs",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "postbuild": "node scripts/check-appearance.mjs"
  },
  "dependencies": {
    "@kimtos/config": "*",
    "@kimtos/icons": "*",
    "@kimtos/releaser": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "mermaid": "^12.3.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue-tsc": "^3.3.14"
  },
  "license": "MIT",
  "version": "1.1.1"
}
