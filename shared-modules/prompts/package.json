{
  "name": "@kimtos/prompts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared prompt library — Markdown prompts as the source of truth, plus a tiny SDK to render them into model messages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "gen": "tsx scripts/build-prompts.ts",
    "build": "npm run gen && tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@kimtos/config": "*"
  },
  "license": "MIT"
}
